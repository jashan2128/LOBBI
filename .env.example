# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" (anon) key. Safe for the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Your site's public address (used for Open Graph links).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where people can reach you (shown on the Privacy page and in the footer).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# SECRET key. Supabase dashboard -> Project Settings -> API Keys -> "Secret keys".
# SERVER ONLY. Never put NEXT_PUBLIC_ in front of it, never commit it, never share it.
# Used for exactly one thing: counting waitlist tries per visitor (rate limiting).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
